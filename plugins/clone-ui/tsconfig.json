{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "test/**/*.ts", "vite.config.ts"],
  "exclude": ["server/memory/worker.ts"]
}
